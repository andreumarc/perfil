# ==============================================================
#  Variables de entorno — copia este archivo a .env.local y rellénalo.
#  NUNCA subas .env ni .env.local al repositorio.
#  Ninguna variable es obligatoria para arrancar en local: la app degrada
#  (sin DB → contenido por defecto y formularios desactivados; sin Resend → sin emails).
# ==============================================================

# --- Base de datos (Neon PostgreSQL) ---------------------------
# Consola Neon → tu proyecto → Connect → "Connection string" (pooled).
DATABASE_URL=

# --- Sitio -----------------------------------------------------
# URL pública canónica (sin barra final). Se usa para SEO, sitemap y emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Autenticación del panel -----------------------------------
# Secreto para firmar las sesiones (mínimo 32 caracteres): openssl rand -base64 32
AUTH_SECRET=
# Token de un solo uso para crear el primer administrador en /admin/setup.
# Bórralo (o déjalo vacío) después de crear la cuenta.
ADMIN_SETUP_TOKEN=

# --- Email transaccional (Resend) ------------------------------
# Sin RESEND_API_KEY la app funciona igual pero no envía emails.
RESEND_API_KEY=
# Remitente verificado en Resend. Con el dominio de pruebas solo se entrega al dueño de la cuenta.
EMAIL_FROM="Reformas <onboarding@resend.dev>"
# Destinatario de los avisos de nuevo lead si no hay emails configurados en /admin/ajustes.
NOTIFY_EMAIL=

# --- Almacenamiento (Vercel Blob) ------------------------------
# Store público para imágenes del sitio (proyectos, blog).
BLOB_READ_WRITE_TOKEN=
# Store PRIVADO para adjuntos de leads (solo accesibles desde el panel).
BLOB_PRIVATE_READ_WRITE_TOKEN=

# --- Anti-spam opcional (Cloudflare Turnstile) -----------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Privacidad -------------------------------------------------
# Sal para pseudonimizar IPs (obligatoria en producción para guardar hashes): openssl rand -hex 16
IP_HASH_SALT=

# --- Desarrollo -------------------------------------------------
# Sin base de datos, muestra los artículos en borrador en el blog (solo para revisar contenido en local).
PREVIEW_DRAFTS=
