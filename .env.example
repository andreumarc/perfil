# ==============================================================
#  Variables de entorno — copia este archivo a .env y rellénalo.
#  NUNCA subas .env al repositorio.
# ==============================================================

# --- Base de datos (Neon PostgreSQL) ---------------------------
# Consola Neon → tu proyecto → Connect → "Connection string" (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Sitio -----------------------------------------------------
# URL pública canónica (sin barra final). Se usa para SEO, sitemap y emails.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# URL de reserva de reunión (Calendly u otra). Si está vacía, los CTA de
# reunión llevan a /contacto.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/tu-usuario/sesion-estrategica-30min

# Perfil LinkedIn (opcional). Si está vacío, se ocultan los enlaces a LinkedIn.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/tu-perfil

# Email de contacto público (opcional). Si está vacío, no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin / CRM -----------------------------------------------
# Email que recibe las notificaciones de nuevos leads y que se usa para
# iniciar sesión en /admin.
ADMIN_EMAIL=tu@email.com
# Contraseña de acceso a /admin (mínimo 12 caracteres).
ADMIN_PASSWORD=cambia-esta-contraseña-larga
# Secreto para firmar la sesión de admin. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Email transaccional (Resend) ------------------------------
# Si RESEND_API_KEY está vacío, la app funciona igual pero no envía emails.
RESEND_API_KEY=
# Remitente verificado en Resend. Por defecto usa el dominio de pruebas.
EMAIL_FROM="Marc Andreu Guerao <onboarding@resend.dev>"

# --- Analytics / marketing (todos opcionales) -------------------
# Solo se cargan tras el consentimiento de cookies del usuario.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Privacidad -------------------------------------------------
# Sal para anonimizar IPs (hash). Genera uno con: openssl rand -hex 16
IP_HASH_SALT=
